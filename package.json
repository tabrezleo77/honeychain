{
  "name": "honey-chain",
  "version": "1.0.0",
  "private": true,
  "description": "HoneyChain platform for supply chain tracking and quality assurance",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:web": "pnpm --filter web dev",
    "dev:ml": "pnpm --filter ml-service dev",
    "build:web": "pnpm --filter web build",
    "build:backend": "pnpm --filter backend build",
    "test:contracts": "pnpm --filter contracts test",
    "db:migrate": "pnpm --filter db db:migrate",
    "db:generate": "pnpm --filter db db:generate"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "keccak",
      "prisma",
      "secp256k1"
    ]
  }
}
